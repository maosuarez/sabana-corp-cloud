{
  "uid": "sabana-muro-equipos",
  "title": "Muro de equipos",
  "tags": ["sabana-corp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Retos por equipo (verde=arriba, rojo=caido) -- legible a 3 metros",
      "description": "probe_success por team/service. xss-bot no tiene sonda propia todavia (ver docs/plans/observability-monitoring.md, El punto ciego: xss-bot).",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "probe_success{group=\"edificio\"}",
          "legendFormat": "team{{team}} / {{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "CAIDO", "color": "red", "index": 0 },
                "1": { "text": "OK", "color": "green", "index": 1 }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "custom": { "lineWidth": 0, "fillOpacity": 100 }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Deriva de IP (webapp/xss-bot con la IP vieja de su dependencia horneada)",
      "description": "sabana_ip_drift == 1 significa que hay que correr restore, no solo reiniciar (ver DerivaDeIP en el plan).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sabana_ip_drift",
          "legendFormat": "team{{team}} / {{service}} -> {{depends_on}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "OK", "color": "green", "index": 0 },
                "1": { "text": "DERIVA", "color": "orange", "index": 1 }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "custom": { "lineWidth": 0, "fillOpacity": 100 }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single" }
      }
    }
  ]
}
