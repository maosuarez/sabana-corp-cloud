# yamls/.env.secrets — secretos y flags compartidos por TODOS los equipos (team1, team2, ...
# teamN reciben exactamente el mismo valor). Copia este archivo a `.env.secrets` (gitignored) y
# reemplaza los valores antes del evento; el mismo archivo alimenta CTFd (las flags que pongas
# aca son las que registras como respuesta correcta en cada reto de CTFd).
#
# generate-team.sh lee este archivo automaticamente -- no hace falta exportar estas variables a
# mano.

# ---------------------------------------------------------------------------
# Flags de puntuacion (formato SABANA{...}, una por reto/hito)
# ---------------------------------------------------------------------------

# Reto 1 (Web App) - Stored XSS contra la cookie de sesion del admin.
FLAG_WEBAPP_XSS=SABANA{database_xss_flag_prueba}

# Reto 1 (Web App, opcional) - LFI en adjuntos.
FLAG_WEBAPP_LFI=SABANA{webapp_lfi_flag_prueba}

# Reto 2 (Base de Datos) - acceso de lectura con credenciales filtradas.
FLAG_DATABASE=SABANA{database_flag_prueba}

# Reto 3 (Linux Server) - flag final tras escalar a root, en /root/secrets.txt.
FLAG_LINUXSERVER_ROOT=SABANA{linuxserver_root_flag_prueba}

# Reto 3.6 (Linux Server) - flag en argumentos de proceso (ps aux / /proc/<pid>/cmdline).
FLAG_LINUXSERVER_PROC=SABANA{linuxserver_proc_flag_prueba}

# ---------------------------------------------------------------------------
# Secretos de progresion (no son flags, pero tampoco se commitean)
# ---------------------------------------------------------------------------

# Password SSH del usuario de bajo privilegio en Linux Server. Debe ser una palabra real de
# diccionario (rockyou o similar) -- el participante la obtiene crackeando su hash MD5 en el
# Reto 2. Password reuse deliberado con el usuario "msilva" de la tabla `users`.
PIVOT_SSH_PASSWORD=princess

# Secreto compartido entre webapp y xss-bot para que el bot se autentique como "admin" sin usar
# una contrasena que tambien aparezca en `users`.
BOT_SECRET=changeme_random_bot_secret

MYSQL_ROOT_PASSWORD=changeme_root_password

# Credenciales de la cuenta de aplicacion que webapp usa para conectarse a MariaDB. Se filtran a
# proposito via el endpoint /api/internal/admin/database tras el bypass de JWT.
DB_APP_PASSWORD=changeme_db_app_password

# Firma JWTs nuevos al emitirlos; el backend no verifica la firma al decodificar, asi que este
# valor es irrelevante para la vulnerabilidad -- se trata solo como higiene de secretos.
JWT_SIGNING_SECRET=changeme_jwt_signing_secret

# ---------------------------------------------------------------------------
# CTFd (vm-ctfd, snet-dmz-vm) -- ver docs/plans/ctfd-deployment.md (F2)
# ---------------------------------------------------------------------------
#
# A diferencia de los secretos de arriba, estos NO se inyectan en contenedores de equipo -- los
# lee yamls/generate-ctfd-vm.sh para armar el docker-compose.yml de vm-ctfd (un solo despliegue
# compartido, igual que la DMZ). Las 4 CTFD_PRESET_ADMIN_* son obligatorias (no solo el token):
# create_ctfd_vm() corre el seed de challenges automaticamente contra un admin que CTFd crea al
# vuelo con estos datos -- si quedan vacias, el seed automatico falla.

# Firma las sesiones de todos los usuarios registrados en CTFd (staff y participantes). Generar
# una vez por edicion del evento (ej. `openssl rand -hex 32`) y tratar como secreto -- rotarlo
# invalida sesiones activas.
CTFD_SECRET_KEY=changeme_ctfd_secret_key

CTFD_DB_NAME=ctfd
CTFD_DB_USER=ctfd
CTFD_DB_PASSWORD=changeme_ctfd_db_password
CTFD_DB_ROOT_PASSWORD=changeme_ctfd_db_root_password

# Admin precreado al primer arranque de CTFd (login real por la UI, para el staff del evento).
CTFD_PRESET_ADMIN_NAME=admin
CTFD_PRESET_ADMIN_EMAIL=admin@sabanacorp.internal
CTFD_PRESET_ADMIN_PASSWORD=changeme_ctfd_admin_password

# Token fijo que CTFd acepta como Access Token del admin de arriba (lo crea al vuelo si no existe
# -- ver CTFd/utils/security/auth.py:lookup_user_token). create_ctfd_vm() lo usa para correr
# scripts/seed_challenges.py automaticamente justo despues del deploy, sin login manual. Generar
# con `openssl rand -hex 32` y tratarlo con el mismo cuidado que CTFD_PRESET_ADMIN_PASSWORD --
# quien lo tenga tiene control total de la API admin de CTFd.
CTFD_PRESET_ADMIN_TOKEN=changeme_ctfd_preset_admin_token

# Wizard de /setup: create_ctfd_vm() lo completa automaticamente (scripts/seed_setup.py, corre
# dentro del contenedor ctfd) en vez de pedirlo por el navegador -- fija user_mode=teams,
# registration_visibility=public, verify_emails=false (decision ya tomada en
# docs/plans/ctfd-deployment.md, "Equipos competidores").
CTFD_EVENT_NAME="Sabana Corp CTF"
CTFD_EVENT_DESCRIPTION=
# Limite de integrantes por equipo. Vacio = sin limite.
CTFD_TEAM_SIZE=
